# ==============================================================================
# POD AUTOMATION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Required for Production)
# Get these from: Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (for client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Required for server-side backend API routes & migrations)
# WARNING: NEVER expose this to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Slack Integration (Server-Side Delivery)
# You can configure an Incoming Webhook OR a Slack Bot Token (xoxb-...)
# ------------------------------------------------------------------------------
# Default Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/your-webhook-token

# Optional: Slack Bot User OAuth Token (recommended for multi-channel routing)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# ------------------------------------------------------------------------------
# 3. Security & Scheduler Protection
# ------------------------------------------------------------------------------
# Secret token to authorize /api/cron/execute calls from Vercel or external cron
CRON_SECRET=generate-a-strong-random-cron-secret-key

# Secret key used for cryptographic JWT signing and session validation
AUTH_SECRET=generate-a-strong-random-auth-secret-key-min-32-chars

# Target server URL for the background scheduler daemon
NEXTJS_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Scheduler Execution Tuning
# ------------------------------------------------------------------------------
# Tolerance window in minutes for missed jobs (default 15 minutes)
CRON_TOLERANCE_MINUTES=15

# Missed job strategy: execute_if_within_window or skip_if_expired
MISSED_JOB_POLICY=execute_if_within_window
